# ============================================
# 林立生产环境配置模板
# ============================================app\web端 帮我
# 部署时复制为 .env.prod 并填入真实值：
#   cp .env.prod.example .env.prod
#   vim .env.prod
# 然后启动：
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
# ============================================

# 你的域名（Caddy 会自动申请 HTTPS 证书）
DOMAIN=www.***.com

# ---- 数据库 ----
# 生产环境必须改密码！用 `openssl rand -base64 24` 生成
DB_PASSWORD=改成随机强密码

# ---- 后端 ----
# JWT 密钥：用 `openssl rand -base64 32` 生成，绝对不能泄露
JWT_SECRET=改成64位随机字符串

# CORS：你的网页域名（逗号分隔，不能用 *）
# 注意要带 https://
CORS_ORIGINS=https://www.***.com

# ---- 头像上传 ----
# 上传文件存储目录（容器内路径，配合 docker-compose 的挂卷持久化）
UPLOAD_DIR=/opt/linli-server/uploads
# 对外公开 URL 前缀（拼接图片访问地址用，必须是公网域名）
PUBLIC_BASE_URL=https://api.bbtech.top
