# 复制为 .env 并填入真实值
# cp .env.example .env

# 数据库
DATABASE_URL=postgres://postgres:linli_dev_pwd@localhost:5432/linli

# JWT 密钥（用 `openssl rand -base64 32` 生成，生产环境必改）
JWT_SECRET=Linli_bbtech
JWT_EXPIRES_HOURS=168

# 服务监听
HOST=0.0.0.0
PORT=8080

# CORS（逗号分隔，生产环境填你的域名）
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
