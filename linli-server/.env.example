# 复制为 .env 并填入真实值
# cp .env.example .env

# 数据库
DATABASE_URL=postgres://postgres:linli_dev_pwd@localhost:5432/linli

# JWT 密钥（用 `openssl rand -base64 32` 生成，生产环境必改）
JWT_SECRET=change_me_to_a_random_64_char_string
JWT_EXPIRES_HOURS=168

# 服务监听
HOST=0.0.0.0
PORT=8080

# CORS 允许的前端源（逗号分隔）
# ⚠️ 生产环境必须改成你的真实域名，不能用 localhost，更不能用 *
#    否则任何网站都能调你的 API（凭据会泄露）
# 例如：CORS_ORIGINS=https://www.bbtech.com,https://app.bbtech.com
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
